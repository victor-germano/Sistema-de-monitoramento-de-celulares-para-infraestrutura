# =============================================================================
# Sistema de Monitoramento de Celulares — variáveis de ambiente
# Copie para `.env` e preencha. Nunca commite o `.env` (ver .gitignore).
# Cada variável está comentada; o detalhamento completo fica em docs/SETUP.md.
# =============================================================================

# --- Aplicação (Fase 1) ------------------------------------------------------
NODE_ENV=development
# Porta HTTP do Fastify. 13000 (não a convencional 3000) — ver ADR-014 em
# docs/DECISOES.md: a máquina de dev do Victor tem outro processo ocupando
# a 3000. Ajuste livremente se não for o seu caso.
PORT=13000
# Nível de log do Pino: fatal|error|warn|info|debug|trace
LOG_LEVEL=info
# Origens permitidas por CORS, separadas por vírgula. Ex.: https://painel.gruporoveri.com.br
ALLOWED_ORIGINS=http://localhost:13000

# --- Banco de dados (Fase 1) --------------------------------------------------
# String de conexão Postgres. Ao rodar via `docker compose up` (stack completa),
# o serviço `api` sobrescreve o host para `postgres` (nome do serviço na rede
# do compose) — este valor aqui é para rodar a API localmente (fora de
# container) contra o Postgres subido pelo compose, exposto em localhost.
DATABASE_URL=postgres://app:app@localhost:5432/mdm
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=mdm

# --- Redis / filas (Fase 1 no health check; BullMQ a partir da Fase 3) -------
REDIS_URL=redis://localhost:6379

# --- Autenticação corporativa / OIDC (Fase 2) --------------------------------
# Emissor OIDC. Trocar de Google Workspace para Microsoft Entra ID exige só
# mudar estas três variáveis — o código escolhe o `OidcDomainValidator` certo
# a partir do próprio issuer (ver ADR-003 em docs/DECISOES.md).
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=TODO_preencher_no_console_do_provedor
OIDC_CLIENT_SECRET=TODO_preencher_no_console_do_provedor
OIDC_REDIRECT_URI=http://localhost:13000/auth/callback
# URL do frontend para onde /auth/callback redireciona após o login
# (contrato do callback documentado em ADR-010).
FRONTEND_URL=http://localhost:5173
# Domínios corporativos aceitos no login (claim `hd` no Google), separados por
# vírgula. Obrigatório ter pelo menos um.
ALLOWED_EMAIL_DOMAINS=gruporoveri.com.br
# E-mails que recebem role ADMIN já no primeiro login, em vez de VIEWER —
# resolve o problema do "primeiro ADMIN" (provisionamento JIT sempre cria
# VIEWER; sem isso ninguém nunca sairia de VIEWER). Separados por vírgula,
# opcional. Recomendado: só o(s) e-mail(s) de quem vai fazer o setup inicial
# — depois disso, promoção de role passa a ser via PATCH /usuarios/:id.
BOOTSTRAP_ADMIN_EMAILS=

# Segredo para assinar o JWT interno de sessão (15 min) e o refresh token
# rotativo (8h). Gere com `openssl rand -base64 48`; nunca reutilize entre
# ambientes. Mínimo de 32 caracteres (validado no boot).
JWT_SECRET=TODO_gerar_segredo_forte
JWT_SESSION_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=8

# --- Android Management API (Fase 3) -----------------------------------------
# Nome da enterprise já vinculada (enterprises/LC...). PLACEHOLDER até a
# empresa confirmar o valor real — ver ADR-005 em docs/DECISOES.md. Bloqueia
# só o teste E2E real contra a AMAPI; o resto da Fase 3 roda contra mocks.
AMAPI_ENTERPRISE_NAME=enterprises/LC00000000000000000
# Caminho local para o JSON da service account (nunca committar o arquivo em
# si — já coberto por .gitignore). Baixado no console do GCP ao criar a
# service account (ver seção 2 da spec / docs/SETUP.md).
AMAPI_SERVICE_ACCOUNT_KEY_PATH=./secrets/amapi-service-account.json

# --- Pub/Sub (Fase 4) --------------------------------------------------------
# Em aberto: nome do tópico/subscription ainda não definidos pela empresa —
# ver ADR-005. GOOGLE_CLOUD_PROJECT e PUBSUB_SUBSCRIPTION já são validados e
# lidos de verdade por src/workers/pubsub-consumer.ts; PUBSUB_TOPIC é só
# referência de documentação (quem publica nele é a própria AMAPI).
GOOGLE_CLOUD_PROJECT=TODO_definir
PUBSUB_TOPIC=TODO_definir
PUBSUB_SUBSCRIPTION=TODO_definir

# --- Motor de alertas (Fase 6) -----------------------------------------------
# Nenhum destes limiares é pedido pela spec (seção 9 só nomeia os 9 tipos) —
# são defaults nossos, documentados em ADR-030/ADR-031, ajustáveis sem
# redeploy. Ver docs/api/alertas.md pro que cada um controla.
ANDROID_VERSAO_MINIMA_SDK=30
ALERTA_SEM_CHECKIN_DIAS=3
ALERTA_PATCH_MAX_DIAS=90
ALERTA_STORAGE_CRITICO_MB=500
ALERTA_BATERIA_CRITICA_PCT=15
ALERTA_DISPOSITIVO_ORFAO_DIAS=7
# Intervalo do scan periódico (src/workers/manutencao-worker.ts) — cobre os
# 3 tipos de alerta sobre AUSÊNCIA de atividade (SEM_CHECKIN/
# DISPOSITIVO_ORFAO/LINHA_SEM_USO).
ALERTA_SCAN_INTERVALO_HORAS=6
# Best-effort, opcional — vazio desliga a notificação (nunca a criação do
# alerta em si, que sempre acontece no banco independente disso).
ALERT_WEBHOOK_URL=

# --- LGPD / retenção (Fase 6) -------------------------------------------------
# `COLETA_LOCALIZACAO_ATIVA`/`RETENCAO_LOCALIZACAO_DIAS` continuam só
# documentadas aqui, sem efeito real: a AMAPI não coleta localização de
# forma contínua (só via "Lost Mode", fora de escopo — ver ADR-026).
COLETA_LOCALIZACAO_ATIVA=false
RETENCAO_LOCALIZACAO_DIAS=90
RETENCAO_EVENTOS_BRUTOS_DIAS=180
