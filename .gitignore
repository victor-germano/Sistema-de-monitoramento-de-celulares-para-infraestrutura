# dependências
node_modules/

# build
dist/
*.tsbuildinfo

# segredos e ambiente local — nunca commitar
.env
.env.local
.env.*.local
*.json.key
service-account*.json

# scripts descartáveis de depuração local (ex.: seed de sessão de teste,
# sempre com `_` na frente por convenção) — rede de segurança extra contra
# um `git add -A` acidental incluir algo que minta token/credencial de
# teste, mesmo que a disciplina de nunca dar `git add` neles já exista.
scripts/_*.ts

# testes / cobertura
coverage/

# logs
*.log
npm-debug.log*

# editor / SO
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
